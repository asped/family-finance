# Database (Neon PostgreSQL - get free account at https://neon.tech)
# For local dev, you can use a local PostgreSQL or the Neon database
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Enable Banking API (https://enablebanking.com)
ENABLE_BANKING_APP_ID="your-app-id"
ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ENABLE_BANKING_REDIRECT_URI="https://your-app.vercel.app/api/enable-banking/callback"

# App URL
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
